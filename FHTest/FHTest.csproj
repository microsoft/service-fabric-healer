<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
		<TargetLatestRuntimePatch>True</TargetLatestRuntimePatch>
        <IsPackable>false</IsPackable>
        <PlatformTarget>AnyCPU</PlatformTarget>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
        <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
        <PackageReference Include="coverlet.collector" Version="6.0.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
		<PackageReference Include="ServiceFabric.Mocks" Version="8.1.3" />
		<PackageReference Include="Microsoft.ServiceFabric.Actors" Version="$(ServiceFabricServicesVersion)" />
		<PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.15" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\FabricHealerProxy\FabricHealerProxy.csproj" />
        <ProjectReference Include="..\FabricHealer\FabricHealer.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Update="clusterManifestRM_5node.xml">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="PackageRoot\Config\LogicRules\AppRules.guan">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="PackageRoot\Config\LogicRules\DiskRules.guan">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="PackageRoot\Config\LogicRules\FabricNodeRules.guan">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="PackageRoot\Config\LogicRules\ReplicaRules.guan">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="PackageRoot\Config\LogicRules\SystemServiceRules.guan">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="PackageRoot\Config\Settings.xml">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="PackageRoot\Config\LogicRules\MachineRules.guan">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Include="$(MSBuildProjectDirectory)\obj\TestApp42.zip" Link="TestApp42.zip">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="testrules_wellformed.guan">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="testrules_malformed.guan">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="testrules_wellformed_maxexecution.guan">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <Target Name="BuildTestWorkload" BeforeTargets="PrepareForBuild">
        <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\Build-TestWorkloads.ps1&quot; -Configuration &quot;$(Configuration)&quot;" />
    </Target>
</Project>
