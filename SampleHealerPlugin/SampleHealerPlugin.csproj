<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Logic.Guan" Version="$(GuanPackageVersion)" />
		<PackageReference Include="Newtonsoft.Json" Version="$(JsonVersion)" />
		
        <!-- This is an external nupkg that this plugin sample requires. This is unrelated to the above FH-related reference choices. -->
		<PackageReference Include="Polly" Version="$(PollyVersion)" />
	</ItemGroup>
	<!-- this is for building the plugin and testing it locally -->
	<ItemGroup>
	  <ProjectReference Include="..\FabricHealer\FabricHealer.csproj" />
	</ItemGroup>
</Project>
