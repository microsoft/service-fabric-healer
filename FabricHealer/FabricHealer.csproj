<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
	<PlatformTarget>AnyCPU</PlatformTarget>
	<RootNamespace>FabricHealer</RootNamespace>
	<AssemblyName>FabricHealer</AssemblyName>
	<TargetLatestRuntimePatch>True</TargetLatestRuntimePatch>
	<Nullable>disable</Nullable>
	<IsServiceFabricServiceProject>True</IsServiceFabricServiceProject>
    <OutputType>Exe</OutputType>
	<Product>FabricHealer</Product>
	<Version>1.4.0</Version>
    <AssemblyVersion>1.3.2.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <PackageId>Microsoft.ServiceFabricApps.FabricHealer</PackageId>
    <PackageId Condition="'$(DeploymentPackageId)' != ''">$(DeploymentPackageId)</PackageId>
    <Authors>Microsoft</Authors>
    <Description>FabricHealer .NET 10 service with .NET 8 and .NET 10 plugin compatibility assets.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/microsoft/service-fabric-healer</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>fhnuget.md</PackageReadmeFile>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeTelemetryAssembly</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="McMaster.NETCore.Plugins" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.Logic.Guan" Version="$(GuanPackageVersion)" />
    <PackageReference Include="System.Text.Json" Version="10.0.15" />
    <PackageReference Include="Microsoft.ServiceFabric.Services" Version="$(ServiceFabricServicesVersion)" />
    <PackageReference Include="Microsoft.ApplicationInsights" Version="2.23.0" />
	<PackageReference Include="Newtonsoft.Json" Version="$(JsonVersion)" />
    <PackageReference Include="NLog" Version="$(NLogVersion)" />
    <PackageReference Include="Octokit" Version="14.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TelemetryLib\TelemetryLib.csproj" PrivateAssets="all" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\fhnuget.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup Condition="'$(DeploymentPackagePath)' != ''">
    <None Include="$(DeploymentPackagePath)\**\*" Pack="true" PackagePath="contentFiles\any\any\" PackageCopyToOutput="true" PackageFlatten="false" />
  </ItemGroup>
  <Target Name="IncludeTelemetryAssembly" DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="$(TargetDir)TelemetryLib.dll" />
    </ItemGroup>
  </Target>
  <ItemGroup>
	<Folder Include="PackageRoot\Data\Plugins\" />
  </ItemGroup>
</Project>